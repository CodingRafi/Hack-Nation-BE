DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave empty for single-process dev (in-memory). Set for production /
# multiple processes, e.g. redis://localhost:6379/0
REDIS_URL=

# Shared secret between the AI process and this backend
INGEST_TOKEN=dev-ingest-token
